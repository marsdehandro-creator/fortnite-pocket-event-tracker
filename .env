# Public, non-secret build settings (committed on purpose). Everything here ends up in the client bundle.

# Absolute URL of the deployed site, with trailing slash. Used for canonical/OG/Twitter tags, robots.txt and sitemap.xml.
VITE_SITE_URL=https://marsdehandro-creator.github.io/fortnite-pocket-event-tracker/

# Optional live data API. When set, the app fetches {base}/updates and {base}/events and falls back to the
# bundled JSON in src/data/ if the request fails or returns invalid data. Leave empty to use the static JSON only.
VITE_TRACKER_API_URL=
