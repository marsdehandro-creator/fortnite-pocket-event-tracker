{
  "name": "fortnite-pocket-event-tracker",
  "version": "2.0.0",
  "description": "Track Fortnite maintenance, update downtime, tournaments, cash cups, FNCS events, and competitive schedules in South African time.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:tournaments": "vite-node scripts/sync-tournaments.ts --"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-node": "^2.1.8",
    "vitest": "2.1.8"
  }
}
